# Root environment for docker-compose.local.yml.
# Copy to .env and adjust: cp .env.example .env
# Never commit the real .env.

# Data source strategy: in-memory (fakes, no DB/board) | prisma (Postgres + real ESP32 HTTP)
DATA_SOURCE=in-memory

# Postgres URL as seen FROM the backend container (compose service name).
# Host-run commands (e2e, scripts) must use localhost instead.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/home_automation_hub

# Single-admin login (POST /auth/login). AUTH_PASSWORD unset disables login (503).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-local

# JWT signing secret shared by login, CLI-issued tokens and n8n.
# All issuers/verifiers must use the same value; set a long random secret outside local dev.
JWT_SECRET=change-me-local-jwt-secret

# Device status/telemetry poller interval in ms; <= 0 disables it.
DEVICE_POLL_INTERVAL_MS=30000

# Timeout for backend -> ESP32 HTTP calls (commands and GET /estado).
ESP32_HTTP_TIMEOUT_MS=5000

# Server-side frontend -> backend base URL (the browser calls same-origin /api/* handlers).
# Container default for docker compose: http://backend:3001.
# Host-run `npm run dev` in frontend/: http://localhost:3001.
API_BASE_URL=http://backend:3001
