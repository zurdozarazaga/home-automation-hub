# Backend server port
PORT=3001

# Data source strategy: in-memory | prisma
DATA_SOURCE=in-memory

# PostgreSQL URL (used when DATA_SOURCE=prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_automation_hub

# Single-admin login (POST /auth/login). AUTH_PASSWORD unset disables login (503).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-local

# JWT signing secret shared by login, auth:issue-token/auth:issue-service and n8n.
# Must be set to a long random value outside local development.
JWT_SECRET=change-me-local-jwt-secret

# Device status/telemetry poller interval in ms; <= 0 disables it.
# Active only with DATA_SOURCE=prisma.
DEVICE_POLL_INTERVAL_MS=30000

# Timeout for backend -> ESP32 HTTP calls (commands and GET /estado).
ESP32_HTTP_TIMEOUT_MS=5000
