# Monorepo: dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build artifacts
frontend/.next/
frontend/out/
frontend/build/
backend/dist/
**/coverage/
**/.nyc_output/
**/*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
**/.env
**/.env.*
!**/.env.example

# Next.js generated file
frontend/next-env.d.ts

# Deployment / tooling
frontend/.vercel/

# OS / editor
.DS_Store
Thumbs.db

# Agent-local tooling (machine-specific absolute paths, auto-generated)
.atl/

# Certificates and keys
*.pem
